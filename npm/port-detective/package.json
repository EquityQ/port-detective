{
  "name": "port-detective",
  "version": "1.1.0-dev",
  "description": "Minimal-dependency Node.js client for the port-detective CLI.",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "platform.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-test-coverage --test-coverage-lines=45 --test-coverage-branches=65 --test-coverage-functions=55 --test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "port",
    "process",
    "cli",
    "networking",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EquityQ/port-detective.git",
    "directory": "npm/port-detective"
  },
  "homepage": "https://github.com/EquityQ/port-detective/tree/master/npm/port-detective",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
